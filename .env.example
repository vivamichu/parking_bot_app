# Copy to .env and fill in. Only OPENAI_API_KEY is required to run the agents.

# --- LLM (both agents use gpt-4o-mini) ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini

# --- Embeddings ---
# Use "huggingface" to run embeddings locally with no API key.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage paths (defaults are fine) ---
# MILVUS_DB_PATH=./data/milvus_parking.db
# SQLITE_PATH=./data/parking_dynamic.db
# CONFIRMED_RESERVATIONS_PATH=./data/confirmed_reservations.txt

# --- Stage 3: MCP reservation-store server ---
# Route confirmed reservations through the MCP server (true) instead of a direct
# file write. When true, the MCP server below must be running.
MCP_ENABLED=false
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
# REQUIRED to accept writes — the server is fail-closed without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
