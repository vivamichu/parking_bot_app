# Copy to .env and fill in your key.
OPENAI_API_KEY=sk-...

# --- Models (defaults shown) ---
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings backend: "openai" (default) or "huggingface" (local, no key) ---
EMBEDDING_PROVIDER=openai
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage paths (relative to project root) ---
# NOTE: do not rename to MILVUS_URI — pymilvus reads that variable itself.
MILVUS_DB_PATH=./data/milvus_parking.db
MILVUS_COLLECTION=parking_static
SQLITE_PATH=./data/parking_dynamic.db

# --- Optional: LangSmith tracing ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=parking-bot-stage1
